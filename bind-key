#!/usr/bin/bash
# Add one personal binding; never unbind or replace another action.
set -euo pipefail
command -v hyprctl >/dev/null || { echo 'Run omarchy-widget bind-key in your Hyprland session.' >&2; exit 1; }
base="${XDG_CONFIG_HOME:-$HOME/.config}"
[[ "$base" == /* ]] || base="$HOME/.config"
if [[ -f "$base/hypr/hyprland.lua" && -f "$base/hypr/bindings.lua" ]]; then
  target="$base/hypr/bindings.lua"
  binding='o.bind("SUPER + CTRL + SHIFT + W", "Desktop widgets", "omarchy-widget manage")'
elif [[ -f "$base/hypr/hyprland.conf" && -f "$base/hypr/bindings.conf" ]]; then
  target="$base/hypr/bindings.conf"
  binding='bindd = SUPER CTRL SHIFT, W, Desktop widgets, exec, omarchy-widget manage'
else
  echo 'No recognised personal Hyprland bindings file; add a shortcut to omarchy-widget manage manually.' >&2; exit 1
fi
[[ ! -L "$target" ]] || { echo 'Bindings file is a symlink; add the shortcut manually.' >&2; exit 1; }
lock="$target.widget-lock"
mkdir -- "$lock" || { echo 'Bindings file busy.' >&2; exit 1; }
stage=""
trap '[[ -z "$stage" ]] || rm -f -- "$stage"; rmdir -- "$lock"' EXIT
live=$(timeout 3 hyprctl -j binds)
jq -e 'type == "array"' <<< "$live" >/dev/null
conflicts=$(jq '[.[] | select(.modmask == 69 and ((.key | ascii_downcase) == "w" or .keycode == 25))]' <<< "$live")
if [[ $(jq 'length' <<< "$conflicts") != 0 ]]; then
  if jq -e 'all(.[]; .dispatcher == "exec" and .arg == "omarchy-widget manage")' <<< "$conflicts" >/dev/null && grep -Fxq -- "$binding" "$target"; then
    echo 'Desktop widgets shortcut already installed: Super+Ctrl+Shift+W'; exit 0
  fi
  echo 'Super+Ctrl+Shift+W is already assigned; your bindings were not changed.' >&2; exit 1
fi
if grep -Fxq -- "$binding" "$target"; then
  echo 'Binding is already in the file but is not active. Check your Hyprland includes and reload.' >&2; exit 1
fi
backup=$(mktemp "$target.widget-backup.XXXXXXXX")
cp -p -- "$target" "$backup"
stage=$(mktemp "$target.widget-stage.XXXXXXXX")
cp -p -- "$target" "$stage"
printf '\n%s\n%s\n' '# Omarchy Widget Core: manager shortcut' "$binding" >> "$stage"
# Lua uses -- for comments.
if [[ "$target" == *.lua ]]; then
  sed -i 's/^# Omarchy Widget Core: manager shortcut$/-- Omarchy Widget Core: manager shortcut/' "$stage"
fi
mv -- "$stage" "$target"; stage=""
if ! timeout 3 hyprctl reload >/dev/null || ! timeout 3 hyprctl -j binds | jq -e 'any(.[]; .modmask == 69 and ((.key | ascii_downcase) == "w" or .keycode == 25) and .dispatcher == "exec" and .arg == "omarchy-widget manage")' >/dev/null; then
  cp -p -- "$backup" "$target"
  timeout 3 hyprctl reload >/dev/null 2>&1 || true
  echo "Shortcut did not activate; restored bindings. Backup: $backup" >&2; exit 1
fi
echo "Desktop widgets: Super+Ctrl+Shift+W. Previous bindings: $backup"
