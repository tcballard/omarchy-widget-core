#!/usr/bin/bash
set -uo pipefail
core_id=io.github.tcballard.widget-core
config="$HOME/.config/omarchy/plugins/$core_id"
unit=omarchy-widget-host.service
method=${1:-help}
start() {
  # Import only desktop-routing variables, never the entire environment.
  for name in WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_DATA_HOME XDG_STATE_HOME; do
    [[ -n ${!name:-} ]] && systemctl --user import-environment "$name"
  done
  systemctl --user start "$unit"
}
case "$method" in
  start) start; exit $? ;;
  stop) systemctl --user stop "$unit"; exit $? ;;
  restart) systemctl --user restart "$unit"; exit $? ;;
  logs) journalctl --user -u "$unit" -u 'omarchy-widget-island-*.service' -n 80 --no-pager; exit $? ;;
  status)
    systemctl --user is-active "$unit" || exit $?
    "$config/bin/omarchy-widget" list; exit $? ;;
  sandbox-check) exec /usr/bin/bash "$config/sandbox-launch" check ;;
  manage|arrange|refresh|show|hide-all)
    start || exit $?
    "$config/bin/omarchy-widget" control "$method"; exit $? ;;
esac
"$config/bin/omarchy-widget" "$@"
result=$?
if (( result == 0 )); then
  case "$method" in
    install|update|rollback|remove|add|duplicate|hide|place|configure|save)
      : ;;
  esac
fi
exit "$result"
