{
  "schemaVersion": 2,
  "coreApi": 2,
  "kind": "desktop-widget",
  "id": "io.example.starter",
  "name": "Widget starter",
  "version": "0.1.0",
  "entryPoint": "View.qml",
  "settingsEntryPoint": "Settings.qml",
  "families": ["small", "medium", "large"],
  "defaultFamily": "small",
  "defaults": {"title": "Today", "note": "Choose one thing to focus on."},
  "settingsVersion": 1,
  "settingsSchema": {
    "type": "object",
    "properties": {"title": {"type": "string", "maxLength": 80}, "note": {"type": "string", "maxLength": 2000}},
    "required": ["title", "note"],
    "additionalProperties": false
  },
  "capabilities": [],
  "refresh": "none",
  "dependencies": {"commands": []}
}
