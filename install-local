#!/usr/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
core_id=io.github.tcballard.widget-core
destination="$HOME/.config/omarchy/plugins/$core_id"
for command_name in cargo omarchy omarchy-shell jq qs systemctl systemd-run timeout bwrap git; do
  command -v "$command_name" >/dev/null || { echo "Missing command: $command_name" >&2; exit 1; }
done
[[ $# -eq 0 || ( $# -eq 1 && "$1" == --update ) ]] || { echo 'Usage: bash install-local [--update]' >&2; exit 1; }
[[ ! -L "$destination" ]] || { echo 'Refusing symlink installation.' >&2; exit 1; }
if [[ -e "$destination" && "${1:-}" != --update ]]; then
  echo 'Core already installed. Use bash install-local --update.' >&2; exit 1
fi
# The 0.1.x → 0.0.2 reset is intentional; compare contracts, not version order.
cargo build --manifest-path "$root/Cargo.toml" --locked --release
bash "$root/build-wayland-filter"
omarchy plugin validate "$root"
"$root/target/release/omarchy-widget" list >/dev/null
"$root/target/release/omarchy-widget" resource-preflight >/dev/null
mkdir -p "$root/bin"
install -m755 "$root/target/release/omarchy-widget" "$root/bin/omarchy-widget"
bash "$root/sandbox-launch" check
mkdir -p -- "$(dirname -- "$destination")" "$HOME/.local/bin"
stage=$(mktemp -d "$(dirname -- "$destination")/.widget-core.XXXXXXXX")
backup=""
unit_path="$HOME/.config/systemd/user/omarchy-widget-host.service"
unit_backup=$(mktemp)
had_unit=false
if [[ -f "$unit_path" ]]; then cp -- "$unit_path" "$unit_backup";had_unit=true;fi
launcher_path="$HOME/.local/bin/omarchy-widget"
launcher_backup=$(mktemp)
had_launcher=false
if [[ -f "$launcher_path" ]]; then cp -- "$launcher_path" "$launcher_backup";had_launcher=true;fi
activated=false
cleanup() {
  result=$?
  rm -rf -- "$stage"
  if (( result != 0 )) && [[ "$activated" == true ]]; then
    systemctl --user stop omarchy-widget-host.service >/dev/null 2>&1 || true
    if [[ "$had_unit" == true ]]; then cp -- "$unit_backup" "$unit_path";else rm -f -- "$unit_path";fi
    if [[ "$had_launcher" == true ]]; then install -m755 "$launcher_backup" "$launcher_path";else rm -f -- "$launcher_path";fi
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    omarchy plugin disable "$core_id" >/dev/null 2>&1 || true
    failed=$(mktemp -d "$(dirname -- "$destination")/.widget-core-failed.XXXXXXXX")
    mv -- "$destination" "$failed/core" || true
    if [[ -n "$backup" && -d "$backup/core" ]]; then
      mv -- "$backup/core" "$destination"
      omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
      omarchy plugin enable "$core_id" >/dev/null 2>&1 || true
    fi
    echo "Core activation failed; previous installation restored. Failed copy: $failed/core" >&2
  fi
  rm -f -- "$unit_backup" "$launcher_backup"
}
trap cleanup EXIT
cp -- "$root/manifest.json" "$root/Service.qml" "$root/Host.qml" "$root/shell.qml" "$root/widget" "$root/host-launch" "$root/sandbox-launch" "$root/wayland-filter.toml" "$root/LICENSE" "$stage/"
cp -R -- "$root/qml" "$root/Commons" "$root/Ui" "$stage/"
mkdir "$stage/bin"
install -m755 "$root/wayland-policy" "$stage/wayland-policy"
install -m755 "$root/target/wl-mitm-source/target/release/wl-mitm" "$stage/bin/wl-mitm"
mkdir "$stage/wl-mitm-source"
tar -C "$root/target/wl-mitm-source" --exclude=./target --exclude=./.git -cf - . | tar -C "$stage/wl-mitm-source" -xf -
install -m755 "$root/target/release/omarchy-widget" "$stage/bin/omarchy-widget"
if [[ -d "$destination" ]]; then
  systemctl --user stop omarchy-widget-host.service 2>/dev/null || true
  omarchy plugin disable "$core_id"
  backup=$(mktemp -d "$(dirname -- "$destination")/.widget-core-backup.XXXXXXXX")
  mv -- "$destination" "$backup/core"
  echo "Previous Core saved at $backup/core"
fi
activated=true
mv -T -- "$stage" "$destination"
omarchy-shell shell rescanPlugins
for ((attempt=0;attempt<40;attempt++)); do
  if omarchy plugin list --json | jq -e --arg id "$core_id" 'any(.[]; .id==$id)' >/dev/null; then
    omarchy plugin enable "$core_id"
    install -m755 "$root/widget" "$HOME/.local/bin/omarchy-widget"
    mkdir -p "$HOME/.config/systemd/user"
    cat > "$HOME/.config/systemd/user/omarchy-widget-host.service" <<'UNIT'
[Unit]
Description=Omarchy desktop widget host
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/bash "%h/.config/omarchy/plugins/io.github.tcballard.widget-core/host-launch"
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
MemoryMax=512M
TasksMax=256
CPUQuota=100%

[Install]
WantedBy=graphical-session.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable omarchy-widget-host.service
    bash "$destination/widget" start
    echo 'Core v0.0.2 installed with a separate widget host. Restart the shell once to replace the old in-process service: omarchy restart shell'
    echo 'After migration, only widgets need restarting: omarchy-widget restart'
    echo "Open manager: omarchy-shell $core_id manage"
    exit 0
  fi
  sleep 0.1
done
echo 'Core discovery failed.' >&2
exit 1
