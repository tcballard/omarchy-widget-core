#!/usr/bin/bash
# Each runner sees one immutable package and two authority-limited sockets.
set -euo pipefail
mode=${1:-check}
[[ ( "$mode" == check && $# -le 1 ) || ( "$mode" == runner && $# -eq 4 ) ]] || { echo 'Usage: sandbox-launch check | runner PACKAGE BROKER FILTERED_DISPLAY' >&2; exit 2; }
config=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
[[ -x /usr/bin/bwrap ]] || { echo 'Bubblewrap is required.' >&2; exit 1; }
args=(--unshare-all --die-with-parent --new-session --cap-drop ALL --clearenv
      --ro-bind /usr /usr --proc /proc --dev /dev --tmpfs /tmp
      --dir /run --perms 0700 --dir /run/widget-core --dir /etc --dir /widget
      --dir /app --dir /app/bin
      --ro-bind "$config/bin/omarchy-widget" /app/bin/omarchy-widget
      --setenv HOME /tmp/home --setenv PATH /usr/bin:/bin --setenv LANG C.UTF-8
      --setenv XDG_DATA_HOME /tmp/data --setenv XDG_STATE_HOME /tmp/state
      --setenv XDG_CACHE_HOME /tmp/cache --setenv XDG_CONFIG_HOME /tmp/config
      --setenv XDG_RUNTIME_DIR /run/widget-core
      --setenv QT_QPA_PLATFORM wayland --setenv QT_QUICK_BACKEND software
      --setenv OMARCHY_WIDGET_ROLE runner --setenv OMARCHY_WIDGET_SANDBOX package-offline-v2
      --setenv OMARCHY_WIDGET_BROKER /run/widget-core/broker --chdir /app)
for item in Host.qml shell.qml qml Commons Ui; do
  args+=(--ro-bind "$config/$item" "/app/$item")
done
for item in bin sbin lib lib64; do
  if [[ -L "/$item" ]]; then args+=(--symlink "$(readlink -- "/$item")" "/$item")
  elif [[ -d "/$item" ]]; then args+=(--ro-bind "/$item" "/$item"); fi
done
for item in /etc/ld.so.cache /etc/fonts /etc/localtime; do
  [[ ! -e "$item" ]] || args+=(--ro-bind "$item" "$item")
done
if [[ "$mode" == check ]]; then exec /usr/bin/bwrap "${args[@]}" -- /usr/bin/true; fi
[[ -d "$2" && ! -L "$2" && -S "$3" && ! -L "$3" && -S "$4" && ! -L "$4" ]] || { echo 'Runner package or capability socket unavailable.' >&2; exit 1; }
args+=(--ro-bind "$2" /widget --ro-bind "$3" /run/widget-core/broker
       --ro-bind "$4" /run/widget-core/wayland-0 --setenv WAYLAND_DISPLAY wayland-0)
exec /usr/bin/bwrap "${args[@]}" -- /usr/bin/qs --no-duplicate -p /app
