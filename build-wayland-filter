#!/usr/bin/bash
# Build a pinned external GPL-3.0 proxy; keep its sources and license available.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
revision=fd1f9da658c5729c41a2dbc1c652d68115d5ca59
checkout="$root/target/wl-mitm-source"
if [[ ! -d "$checkout/.git" ]]; then
  git clone https://github.com/PeterCxy/wl-mitm.git "$checkout"
fi
git -C "$checkout" checkout --detach "$revision"
[[ "$(git -C "$checkout" rev-parse HEAD)" == "$revision" ]]
(cd "$checkout" && cargo run --locked -p protogen && cargo build --locked --release)
